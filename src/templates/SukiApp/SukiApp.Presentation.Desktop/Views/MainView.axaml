<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SukiApp.Presentation.Desktop.Views.MainView"
             xmlns:vm="clr-namespace:SukiApp.Presentation.Desktop.ViewModels"
             x:DataType="vm:MainViewModel">

	<Border>
		<ContentControl Padding="20" Content="{Binding CurrentContent}" Background="{DynamicResource SystemRegionColor}" />
	</Border>

</UserControl>
