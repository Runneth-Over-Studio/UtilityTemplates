<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SukiApp.Presentation.Desktop.Views.MainView"
             xmlns:vm="clr-namespace:SukiApp.Presentation.Desktop.ViewModels"
             x:DataType="vm:MainViewModel"
			 xmlns:suki="https://github.com/kikipoulet/SukiUI"
			 xmlns:i="using:Material.Icons.Avalonia">

	<suki:SukiSideMenu IsSearchEnabled="False" ItemsSource="{Binding NavMenuPages}" SelectedItem="{Binding ActivePage, Mode=TwoWay}">

		<suki:SukiSideMenu.HeaderContent>
			<Image Width="80" Height="80" Margin="30,10,30,30" Source="/Base/Assets/icon.png" />
		</suki:SukiSideMenu.HeaderContent>

		<suki:SukiSideMenu.ItemTemplate>
			<DataTemplate>
				<suki:SukiSideMenuItem Classes="Compact" Header="{Binding DisplayName}">
					<suki:SukiSideMenuItem.Icon>
						<i:MaterialIcon Kind="{Binding Icon}" />
					</suki:SukiSideMenuItem.Icon>
				</suki:SukiSideMenuItem>
			</DataTemplate>
		</suki:SukiSideMenu.ItemTemplate>
		
	</suki:SukiSideMenu>

</UserControl>
