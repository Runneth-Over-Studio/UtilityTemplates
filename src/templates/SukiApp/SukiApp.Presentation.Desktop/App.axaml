<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:v="clr-namespace:SukiApp.Presentation.Desktop.Views"
             xmlns:vm="clr-namespace:SukiApp.Presentation.Desktop.ViewModels"
             x:Class="SukiApp.Presentation.Desktop.App"
			 xmlns:sukiUi="clr-namespace:SukiUI;assembly=SukiUI"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <v:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <v:SettingsView />
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Styles>
		<sukiUi:SukiTheme ThemeColor="Blue" />
        <i:MaterialIconStyles />
    </Application.Styles>

    <Application.Resources>
        <FontFamily x:Key="ViewHeadingFont">avares://SukiApp.Presentation.Desktop/Base/Assets/Fonts/akashi-font#Akashi</FontFamily>
    </Application.Resources>

</Application>
