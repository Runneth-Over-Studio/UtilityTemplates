<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <Product>SukiApp</Product>
    <Description>Cross-platform Avalonia application that targets desktop.</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SukiApp.Business\SukiApp.Business.csproj" />
    <ProjectReference Include="..\SukiApp.Data\SukiApp.Data.csproj" />
    <ProjectReference Include="..\SukiApp.Integrations\SukiApp.Integrations.csproj" />
    <ProjectReference Include="..\SukiApp.Presentation.Desktop\SukiApp.Presentation.Desktop.csproj" />
  </ItemGroup>
</Project>
